{
    "version": "2.0.0",
    "configurations": [
        {
            "name": "Debug executable 'rusktex'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "run",
                    "--bin=rusktex"
                ]
            },
            "args": []
        },
		{
            "name": "Debug executable 'rusktex-score'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "run",
                    "--bin=rusktex-score"
                ]
            },
            "args": ["CWE-1104"]
        },
        {
            "name": "Debug unit tests in executable 'rusktex'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "test",
                    "--bin=rusktex"
                ]
            }
        }
    ],
    "tasks": [
    {
      "label": "cargo build",
      "type": "shell",
      "command": "cargo",
      "args": ["build"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$rustc"],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}