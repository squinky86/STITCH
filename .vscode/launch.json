{
    "version": "2.0.0",
    "configurations": [
        {
            "name": "Debug executable 'stitch'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "run",
                    "--bin=stitch"
                ]
            },
            "args": []
        },
		{
            "name": "Debug executable 'stitch-score'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "run",
                    "--bin=stitch-score"
                ]
            },
            "args": [
				"CWE-9999"
            ]
        },
        {
            "name": "Debug unit tests in executable 'stitch'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "test",
                    "--bin=stitch"
                ]
            }
        }
    ],
    "tasks": [
    {
      "label": "cargo build",
      "type": "shell",
      "command": "cargo",
      "args": ["build"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$rustc"],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}